<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#06B6D4"/>
      <stop offset="100%" stop-color="#3B82F6"/>
    </linearGradient>
    <filter id="blur" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="40"/>
    </filter>
  </defs>
  <rect width="800" height="500" fill="#0f0f17"/>
  <circle cx="200" cy="150" r="250" fill="#06B6D4" opacity="0.3" filter="url(#blur)"/>
  <circle cx="600" cy="350" r="250" fill="#3B82F6" opacity="0.3" filter="url(#blur)"/>
  
  <rect x="80" y="60" width="640" height="380" rx="16" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
  
  <circle cx="120" cy="95" r="7" fill="#F472B6"/>
  <circle cx="140" cy="95" r="7" fill="#A78BFA"/>
  <circle cx="160" cy="95" r="7" fill="#3B82F6"/>
  
  <text x="400" y="240" font-family="'Poppins', sans-serif" font-weight="700" font-size="38" fill="#ffffff" text-anchor="middle">Foto Kita Blur</text>
  <text x="400" y="290" font-family="'Poppins', sans-serif" font-weight="500" font-size="20" fill="#A78BFA" text-anchor="middle">Computer Vision / Gesture Control</text>
  
  <rect x="280" y="330" width="240" height="40" rx="20" fill="url(#bg)" opacity="0.8"/>
  <text x="400" y="356" font-family="'Poppins', sans-serif" font-weight="600" font-size="14" fill="#ffffff" text-anchor="middle">DEMO PREVIEW</text>
</svg>